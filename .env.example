# =============================================================================
# Environment Variables Configuration Template
# Copy this file to .env and customize the values for your local environment
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO VERSION CONTROL
# =============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=career_recommendation_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Service Configuration
BACKEND_PORT=8080

# Frontend Service Configuration
FRONTEND_PORT=3000

# Security / JWT Configuration (Placeholders for upcoming authentication module)
JWT_SECRET=your_base64_or_random_secret_key_at_least_256_bits_here
JWT_EXPIRATION_MS=86400000
